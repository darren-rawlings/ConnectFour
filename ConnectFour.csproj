<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>ConnectFour</RootNamespace>
    <Nullable>enable</Nullable>
    <!-- Unit tests are a separate project, and the AdMob plugin's sample code isn't needed: keep both out of the game assembly. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;addons/admob/csharp/sample/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
